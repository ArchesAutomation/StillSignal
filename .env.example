NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private beta by default. Enable only after email delivery is configured.
NEXT_PUBLIC_OPEN_SIGNUP=false

# Staging setup. Never point the staging worker at the production project.
APP_ENV=staging
APP_ORIGIN=
BROKER_STAGING_PROJECT_REF=
# Vercel server settings: enable only after the corresponding Edge Functions and
# additive database migration are installed in the selected environment.
BROKER_SERVICES_ENABLED=false
MARKET_SERVICES_ENABLED=false
# Server-only: provide these to Supabase Edge Functions and the persistent worker.
# BROKER_ENCRYPTION_KEY is a base64-encoded 32-byte AES key.
BROKER_ENCRYPTION_KEY=
SUPABASE_SECRET_KEY=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_COMMERCIAL_ENABLED=false
# Enable only after stable transaction IDs are contractually available.
SNAPTRADE_STABLE_IDS=false
TRADESTATION_CLIENT_ID=
TRADESTATION_CLIENT_SECRET=
TRADESTATION_APPROVED=false
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_APPROVED=false
PROJECTX_ENABLED=false
OANDA_ENABLED=false
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
ALPACA_APPROVED=false
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_APPROVED=false
# tastytrade sandbox applications use separate credentials.
TASTYTRADE_PAPER_CLIENT_ID=
TASTYTRADE_PAPER_CLIENT_SECRET=
DATABENTO_API_KEY=
MASSIVE_API_KEY=

# Isolated synthetic UI review only; leave off for connected staging and production.
TRADERPULSE_UI_REVIEW=false
NEXT_PUBLIC_UI_REVIEW=false

# Server-only Supabase Edge Function secrets. Groq free tier is preferred when set.
GROQ_API_KEY=
# Optional OpenAI fallback when Groq is not configured.
VOICE_TRANSCRIPTION_API_KEY=
